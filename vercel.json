{
  "version": 2,
  "buildCommand": "cd web/frontend && npm install && npm run build",
  "outputDirectory": "web/frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://diyargezen-web.onrender.com/api/$1"
    },
    {
      "source": "/templates/(.*)",
      "destination": "https://diyargezen-web.onrender.com/templates/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
