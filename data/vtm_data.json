{
  "system": "VAMPIRE_THE_MASQUERADE_5E",
  "source": "worldofdarkness.com",
  "clans": {
    "Brujah": {
      "name": "Brujah",
      "description": "The Learned Clan, scholars and revolutionaries",
      "bane": "Their passionate nature makes them quick to anger, especially against those in authority",
      "disciplines": [
        "Celerity",
        "Potence",
        "Presence"
      ],
      "compulsion": "Rage",
      "favored_attributes": [
        "Strength",
        "Charisma"
      ],
      "clan_weakness": "Frenzy when dealing with authority figures"
    },
    "Gangrel": {
      "name": "Gangrel",
      "description": "The Beast Clan, savages and wanderers",
      "bane": "Their bestial nature emerges when hungry or angry",
      "disciplines": [
        "Animalism",
        "Fortitude",
        "Protean"
      ],
      "compulsion": "Feral instincts",
      "favored_attributes": [
        "Composure",
        "Wits"
      ],
      "clan_weakness": "Animalistic features emerge when hungry"
    },
    "Malkavian": {
      "name": "Malkavian",
      "description": "The Moon Clan, mad prophets and visionaries",
      "bane": "Their fractured minds see truths others cannot",
      "disciplines": [
        "Auspex",
        "Dominate",
        "Obfuscate"
      ],
      "compulsion": "Madness",
      "favored_attributes": [
        "Intelligence",
        "Wits"
      ],
      "clan_weakness": "Insanity and visions"
    },
    "Nosferatu": {
      "name": "Nosferatu",
      "description": "The Sewer Clan, monsters and informants",
      "bane": "Their hideous appearance repels mortals",
      "disciplines": [
        "Animalism",
        "Obfuscate",
        "Potence"
      ],
      "compulsion": "Horror",
      "favored_attributes": [
        "Dexterity",
        "Manipulation"
      ],
      "clan_weakness": "Repulsive appearance"
    },
    "Toreador": {
      "name": "Toreador",
      "description": "The Artisan Clan, artists and hedonists",
      "bane": "Their obsession with beauty consumes them",
      "disciplines": [
        "Auspex",
        "Celerity",
        "Presence"
      ],
      "compulsion": "Aesthetic obsession",
      "favored_attributes": [
        "Charisma",
        "Dexterity"
      ],
      "clan_weakness": "Obsessed with beauty and art"
    },
    "Tremere": {
      "name": "Tremere",
      "description": "The Warlock Clan, mages and schemers",
      "bane": "Their magical bloodline carries ancient debts",
      "disciplines": [
        "Auspex",
        "Blood Sorcery",
        "Dominate"
      ],
      "compulsion": "Thaumaturgy",
      "favored_attributes": [
        "Intelligence",
        "Resolve"
      ],
      "clan_weakness": "Blood magic addiction"
    },
    "Ventrue": {
      "name": "Ventrue",
      "description": "The Lord Clan, aristocrats and leaders",
      "bane": "Their refined tastes demand only the finest blood",
      "disciplines": [
        "Dominate",
        "Fortitude",
        "Presence"
      ],
      "compulsion": "Leadership",
      "favored_attributes": [
        "Charisma",
        "Resolve"
      ],
      "clan_weakness": "Selective feeding"
    },
    "Caitiff": {
      "name": "Caitiff",
      "description": "The Clanless, thin-blooded wanderers",
